# Copy to .env and fill in: `uv run --env-file .env wikicross` and docker-compose.yml read it.
# The app's settings are declared and validated in src/wikicross/config.py; empty lines count as unset.

# --- LLM (required): explanations, and translations in the languages Azure Translator lacks.
# LLM_API_TYPE: openai (any OpenAI-compatible /chat/completions server) or gemini (generateContent).
LLM_API_TYPE=openai
LLM_URL=https://inference.verda.com/v1
LLM_MODEL=kimi-k3-1-pro
LLM_API_KEY=
# Optional, JSON merged into each request (the body; Gemini: generationConfig). Examples:
#   gemini:     LLM_URL=https://generativelanguage.googleapis.com/v1beta  LLM_MODEL=gemini-4-hydrogen
#               LLM_EXTRA={"thinkingConfig": {"thinkingLevel": "low"}}
#   openrouter: LLM_URL=https://openrouter.ai/api/v1  LLM_MODEL=minimax/minimax-m3.1-flash
#               LLM_EXTRA={"reasoning": {"enabled": false}}
LLM_EXTRA=

# --- Decision model (required): which findings are real disagreements, of which kind, how strong.
# OpenRouter's Decisions API (https://openrouter.ai/docs/guides/features/decisions); an OpenRouter key.
DECISION_URL=https://openrouter.ai/api/alpha/decisions
DECISION_MODEL=perplexity/pplx-decider-v1.3:free
DECISION_API_KEY=

# --- Azure AI Translator: quotes past a card's first three, headings, paragraphs.
AZURE_TRANSLATOR_KEY=
# Only for a regional or multi-service resource (e.g. westeurope).
AZURE_TRANSLATOR_REGION=
# AZURE_TRANSLATOR_URL=https://api.cognitive.microsofttranslator.com

# --- Modal (the GPU embeddings): `uv run modal token new`, or modal.com/settings/tokens.
# Locally a token in ~/.modal.toml works too; in Docker set these.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- MariaDB: the defaults match docker-compose.yml (127.0.0.1:3308 locally; the deploy profile sets
# DB_HOST and DB_PORT itself).
# DB_HOST=127.0.0.1
# DB_PORT=3308
# DB_USER=wikicross
# DB_PASSWORD=wikicross
# DB_NAME=wikicross

# --- Rate limit: off unless RATE_LIMIT=1; ALLOWED_IPS (IPs or CIDR ranges, space-separated) are exempt.
RATE_LIMIT=0
# ALLOWED_IPS=127.0.0.1 ::1

# --- Public deployment (README: Deployment): the app and Caddy on ports 80 and 443.
# COMPOSE_PROFILES=deploy
# DOMAIN=wikicross.example.com

# --- OpenTelemetry (README: Deployment): off unless false; the otel profile runs a local backend.
# OTEL_SDK_DISABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:4318
# OTEL_EXPORTER_OTLP_HEADERS=
